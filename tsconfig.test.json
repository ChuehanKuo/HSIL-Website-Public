{
  // Tests run in Node (vitest) and read config files from disk, so they get Node
  // types. The app config stays browser-only so app code can't pick up Node APIs.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"]
  },
  "include": ["src"],
  "exclude": []
}
